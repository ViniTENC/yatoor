NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role secret -- Supabase dashboard > Settings > API. Bypassea RLS,
# solo se usa server-side (app/api/tour), NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# se usa tanto para generar el recorrido como para los embeddings del cache
# semantico (gemini-embedding-001)
GEMINI_API_KEY=
# Places API (New) -- para resolver fotos de POIs por place_id sin
# guardarlas nosotros (app/api/poi-photo). Google Cloud Console > APIs &
# Services > credenciales, con "Places API (New)" habilitada.
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
